# The VPN everything that talks to YouTube goes through (gluetun: any provider it supports).
VPN_SERVICE_PROVIDER=protonvpn
WIREGUARD_PRIVATE_KEY=
SERVER_COUNTRIES=United States
# Optional. When YouTube starts turning the VPN server away, the worker can switch to another one.
# Make a key with: openssl rand -hex 24, put it here, and give gluetun the same key with
#   HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE: '{"auth":"apikey","apikey":"${GLUETUN_KEY}"}'
# in docker-compose.override.yml. Without it the worker waits 45 minutes and tries again.
GLUETUN_KEY=

# Invidious, the player. Make each one with: openssl rand -hex 16  (COMPANION_KEY: exactly 16 characters)
INVIDIOUS_DB_PASSWORD=
INVIDIOUS_HMAC_KEY=
COMPANION_KEY=

# Where the database, temp audio and caches live, and where Whisper keeps its models.
DATA_DIR=./data
MODELS_DIR=./models

# The address people open Tamlil at (it goes in the emails), the name the invite is signed
# with, and the time zone.
TAMLIL_URL=http://localhost:8445
TAMLIL_SIGNATURE=Tamlil
TZ=UTC

# Leave empty to use this stack's own Invidious through the gateway.
PLAYER_URL=
